# Geographic data runs with fixtures until a server Maps key is configured.
# Gemini is not invoked by the current manual planning flow.
DATA_MODE=demo
# Optional override: demo or live. Leave blank to detect the server Maps key.
MAPS_DATA_MODE=
# Optional weather forecast overlay: off or live.
WEATHER_DATA_MODE=off
# Server only. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_MAPS_SERVER_API_KEY=
# Optional browser map. Restrict this key to your localhost/deployed website origins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Reserved for stretch features; not required or used by this starter.
ELEVENLABS_API_KEY=
TIGER_DATABASE_URL=
