# Geographic data runs with fixtures until a server Maps key is configured.
# The bottom chat composer calls Gemini; manual planning does not.
DATA_MODE=demo
# Optional override: demo or live. Leave blank to detect the server Maps key.
MAPS_DATA_MODE=
# Destination forecast from Open-Meteo. Set to off to disable weather details.
WEATHER_DATA_MODE=live
# Server only. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_MAPS_SERVER_API_KEY=
# Optional browser map. Restrict this key to your localhost/deployed website origins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# PostgreSQL for deployed persistence; TIGER_DATABASE_URL is also accepted.
# With neither URL, development uses .pathwayve/database (embedded PostgreSQL).
DATABASE_URL=
# Optional separate local data directory; leave blank for the default.
PGLITE_DATA_DIR=
# ElevenLabs Speech to Text for the chat mic button.
ELEVENLABS_API_KEY=
TIGER_DATABASE_URL=
# Google Calendar OAuth (server only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Existing Better Auth names are accepted; no Better Auth runtime is required.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Optional overrides; token secret must have at least 32 characters.
GOOGLE_CALENDAR_TOKEN_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
